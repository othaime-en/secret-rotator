[flake8]
max-line-length = 100
ignore = E203, E266, E501, W503, W504
exclude =
    .git,
    __pycache__,
    .venv,
    venv,
    build,
    dist,
    *.egg-info,
    # Deprecated legacy web server, superseded by web/ (Flask blueprints).
    # Scheduled for removal in 1.4.0 (see README/CHANGELOG) - not worth
    # polishing lint debt in code that's on its way out; the replacement
    # (src/secret_rotator/web/) is fully linted.
    src/secret_rotator/web_interface.py
show-source = True
statistics = True